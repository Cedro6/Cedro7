# Owner role: runs migrations and seeds. Never used by the web app.
DATABASE_URL_OWNER=postgres://bos_owner:bos_owner@localhost:5432/bos_dev
# App role: no table ownership, no BYPASSRLS. Every query is subject to row-level security.
DATABASE_URL=postgres://bos_app:bos_app@localhost:5432/bos_dev

# A deployed copy needs all three of these. Without them sign-in stays off.
# SESSION_SECRET=<at least 32 random characters>
# DEV_SIGN_IN=1
# PREVIEW_PASSWORD=<one shared password for people reviewing the preview>
